TS_CERT_NAME=host.example.ts.net
CERT_FILE=/etc/ssl/cert.crt
KEY_FILE=/etc/ssl/cert.key
OWNER_USER=verdant
OWNER_GROUP=verdant
# Run after the cert changes, so the TLS server picks it up instead of serving
# the old one from memory. This file is sourced by bash: quote multi-word values.
RELOAD_COMMAND="systemctl reload nginx"
CHECK_SERVER_HOST=localhost
CHECK_SERVER_PORT=443
CHECK_SERVER_SNI=
CHECK_TIMEOUT_SECONDS=5
